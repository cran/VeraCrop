Package: VeraCrop
Type: Package
Title: Yield Gap Analysis Using Comparative Performance Analysis
Version: 0.1.0
Authors@R: c(
    person("Abolfazl", "Derakhshan", email = "derakhshanabolfazl01@gmail.com", role = c("aut", "cph")),
